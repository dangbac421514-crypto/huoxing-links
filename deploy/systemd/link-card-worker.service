[Unit]
Description=Link Card application queue worker
After=network.target link-card-redis.service
Requires=link-card-redis.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/link-card/current/serve
ExecStart=/www/server/php/83/bin/php artisan queue:work redis --queue=default --sleep=3 --tries=5 --timeout=60 --max-time=3600
Restart=always
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
